{
  "name": "claude-projects",
  "displayName": "Claude Projects",
  "description": "Work on all your projects with Claude Code from one window: projects, worktrees, sessions, per-project source control and files, an attention dashboard and a usage bar.",
  "version": "0.1.0",
  "publisher": "febundi",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "projects",
    "worktrees",
    "sessions"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "onWebviewPanel:claudeProjects.chat",
    "onWebviewPanel:claudeProjects.dashboard"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Claude Projects works on the projects you add yourself, not on the folder open in the window."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeProjects",
          "title": "Claude Projects",
          "icon": "media/icons/activity.svg"
        }
      ]
    },
    "views": {
      "claudeProjects": [
        {
          "id": "claudeProjects.projects",
          "name": "Projects",
          "icon": "media/icons/activity.svg",
          "contextualTitle": "Claude Projects"
        },
        {
          "id": "claudeProjects.scm",
          "name": "Source Control",
          "contextualTitle": "Claude Projects"
        },
        {
          "id": "claudeProjects.files",
          "name": "Files",
          "contextualTitle": "Claude Projects"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "claudeProjects.projects",
        "contents": "No projects yet. Add the folders you work on with Claude Code. They stay where they are; only their paths are saved.\n[Add Project](command:claudeProjects.addProject)\n[Import from Claude History](command:claudeProjects.importProjects)"
      }
    ],
    "commands": [
      {
        "command": "claudeProjects.addProject",
        "title": "Add Project…",
        "category": "Claude Projects",
        "icon": "$(add)"
      },
      {
        "command": "claudeProjects.importProjects",
        "title": "Import Projects from Claude History…",
        "category": "Claude Projects",
        "icon": "$(history)"
      },
      {
        "command": "claudeProjects.removeProject",
        "title": "Remove from Projects",
        "category": "Claude Projects"
      },
      {
        "command": "claudeProjects.renameProject",
