        {
          "command": "claudeProjects.scm.openFile",
          "when": "view == claudeProjects.scm && viewItem =~ /^scm\\.change/",
          "group": "inline@1"
        },
        {
          "command": "claudeProjects.scm.discard",
          "when": "view == claudeProjects.scm && viewItem =~ /^scm\\.change\\.(unstaged|untracked)/",
          "group": "inline@2"
        },
        {
          "command": "claudeProjects.scm.stage",
          "when": "view == claudeProjects.scm && viewItem =~ /^scm\\.change\\.(unstaged|untracked|conflict)/",
          "group": "inline@3"
        },
        {
          "command": "claudeProjects.scm.unstage",
          "when": "view == claudeProjects.scm && viewItem =~ /^scm\\.change\\.staged/",
          "group": "inline@3"
        },
        {
          "command": "claudeProjects.scm.openChange",
          "when": "view == claudeProjects.scm && viewItem =~ /^scm\\.change/",
          "group": "1_open@1"
        },
        {
          "command": "claudeProjects.scm.openFile",
          "when": "view == claudeProjects.scm && viewItem =~ /^scm\\.change/",
          "group": "1_open@2"
        },
        {
          "command": "claudeProjects.scm.stage",
          "when": "view == claudeProjects.scm && viewItem =~ /^scm\\.change\\.(unstaged|untracked|conflict)/",
          "group": "2_stage@1"
        },
        {
          "command": "claudeProjects.scm.unstage",
          "when": "view == claudeProjects.scm && viewItem =~ /^scm\\.change\\.staged/",
          "group": "2_stage@1"
        },
        {
          "command": "claudeProjects.scm.discard",
          "when": "view == claudeProjects.scm && viewItem =~ /^scm\\.change\\.(unstaged|untracked)/",
          "group": "2_stage@2"
        },
        {
          "command": "claudeProjects.revealInFinder",
          "when": "view == claudeProjects.scm && viewItem =~ /^scm\\.change/ && !isWindows",
          "group": "3_path@1"
        },
        {
          "command": "claudeProjects.revealInExplorer",
          "when": "view == claudeProjects.scm && viewItem =~ /^scm\\.change/ && isWindows",
          "group": "3_path@1"
        },
        {
          "command": "claudeProjects.copyPath",
          "when": "view == claudeProjects.scm && viewItem =~ /^scm\\.change/",
          "group": "3_path@2"
        },
        {
          "command": "claudeProjects.copyRelativePath",
          "when": "view == claudeProjects.scm && viewItem =~ /^scm\\.change/",
          "group": "3_path@3"
        },
        {
          "command": "claudeProjects.scm.stageAll",
          "when": "view == claudeProjects.scm && viewItem == scm.group.unstaged",
          "group": "inline@2"
        },
        {
          "command": "claudeProjects.scm.discardAll",
          "when": "view == claudeProjects.scm && viewItem == scm.group.unstaged",
          "group": "inline@1"
        },
        {
          "command": "claudeProjects.scm.unstageAll",
          "when": "view == claudeProjects.scm && viewItem == scm.group.staged",
          "group": "inline@1"
        },
        {
          "command": "claudeProjects.scm.commit",
          "when": "view == claudeProjects.scm && viewItem == scm.group.staged",
          "group": "inline@2"
        },
        {
          "command": "claudeProjects.scm.checkout",
          "when": "view == claudeProjects.scm && viewItem == scm.head",
          "group": "inline@1"
        },
        {
          "command": "claudeProjects.scm.createBranch",
          "when": "view == claudeProjects.scm && viewItem == scm.group.branches",
          "group": "inline@1"
        },
        {
          "command": "claudeProjects.createWorktree",
          "when": "view == claudeProjects.scm && viewItem == scm.group.worktrees",
          "group": "inline@1"
        },
        {
          "command": "claudeProjects.scm.checkoutBranch",
          "when": "view == claudeProjects.scm && viewItem =~ /^scm\\.branch\\.(local|remote)$/",
          "group": "inline@1"
        },
        {
          "command": "claudeProjects.scm.checkoutBranch",
          "when": "view == claudeProjects.scm && viewItem =~ /^scm\\.branch\\.(local|remote)$/",
          "group": "1_branch@1"
        },
        {
          "command": "claudeProjects.scm.deleteBranch",
          "when": "view == claudeProjects.scm && viewItem == scm.branch.local",
          "group": "1_branch@2"
        },
        {
          "command": "claudeProjects.scm.selectWorktree",
          "when": "view == claudeProjects.scm && viewItem =~ /^scm\\.worktree/",
          "group": "inline@1"
        },
        {
          "command": "claudeProjects.openInNewWindow",
          "when": "view == claudeProjects.scm && viewItem =~ /^scm\\.worktree/",
          "group": "inline@2"
        },
        {
          "command": "claudeProjects.scm.selectWorktree",
          "when": "view == claudeProjects.scm && viewItem =~ /^scm\\.worktree/",
          "group": "1_wt@1"
        },
        {
          "command": "claudeProjects.openInNewWindow",
          "when": "view == claudeProjects.scm && viewItem =~ /^scm\\.worktree/",
          "group": "1_wt@2"
        },
        {
          "command": "claudeProjects.revealInFinder",
          "when": "view == claudeProjects.scm && viewItem =~ /^scm\\.worktree/ && !isWindows",
          "group": "1_wt@3"
        },
        {
          "command": "claudeProjects.revealInExplorer",
          "when": "view == claudeProjects.scm && viewItem =~ /^scm\\.worktree/ && isWindows",
          "group": "1_wt@3"
        },
        {
          "command": "claudeProjects.removeWorktree",
          "when": "view == claudeProjects.scm && viewItem == scm.worktree.linked",
          "group": "2_wt@1"
        },
        {
          "command": "claudeProjects.scm.copyCommitHash",
          "when": "view == claudeProjects.scm && viewItem == scm.commit",
          "group": "1_commit@1"
        },
        {
          "command": "claudeProjects.openInNewWindow",
          "when": "view == claudeProjects.files && viewItem == files.folder",
          "group": "inline@1"
        },
        {
          "command": "claudeProjects.openInNewWindow",
          "when": "view == claudeProjects.files && viewItem == files.folder",
          "group": "1_open@1"
        },
        {
          "command": "claudeProjects.files.openToSide",
          "when": "view == claudeProjects.files && viewItem == files.file",
          "group": "1_open@1"
        },
        {
          "command": "claudeProjects.revealInFinder",
          "when": "view == claudeProjects.files && viewItem =~ /^files\\./ && !isWindows",
          "group": "1_open@2"
        },
        {
          "command": "claudeProjects.revealInExplorer",
          "when": "view == claudeProjects.files && viewItem =~ /^files\\./ && isWindows",
          "group": "1_open@2"
        },
        {
          "command": "claudeProjects.openTerminal",
          "when": "view == claudeProjects.files && viewItem == files.file",
          "group": "1_open@3"
        },
        {
          "command": "claudeProjects.files.newFile",
          "when": "view == claudeProjects.files && viewItem == files.folder",
          "group": "2_new@1"
        },
        {
          "command": "claudeProjects.files.newFolder",
          "when": "view == claudeProjects.files && viewItem == files.folder",
          "group": "2_new@2"
        },
        {
          "command": "claudeProjects.copyPath",
          "when": "view == claudeProjects.files && viewItem =~ /^files\\./",
          "group": "3_path@1"
        },
        {
          "command": "claudeProjects.copyRelativePath",
          "when": "view == claudeProjects.files && viewItem =~ /^files\\./",
          "group": "3_path@2"
        },
        {
          "command": "claudeProjects.files.rename",
          "when": "view == claudeProjects.files && viewItem =~ /^files\\./",
          "group": "4_edit@1"
        },
        {
          "command": "claudeProjects.files.delete",
          "when": "view == claudeProjects.files && viewItem =~ /^files\\./",
          "group": "4_edit@2"
        },
        {
          "command": "claudeProjects.openTerminal",
          "when": "view == claudeProjects.files && viewItem == files.folder",
          "group": "0_terminal@1"
        },
        {
          "command": "claudeProjects.deleteSession",
          "when": "view == claudeProjects.projects && viewItem =~ /^session/",
          "group": "4_delete@1"
        },
        {
          "command": "claudeProjects.files.cut",
          "when": "view == claudeProjects.files && viewItem =~ /^files\\./",
          "group": "5_cutcopypaste@1"
        },
        {
          "command": "claudeProjects.files.copy",
          "when": "view == claudeProjects.files && viewItem =~ /^files\\./",
          "group": "5_cutcopypaste@2"
        },
        {
          "command": "claudeProjects.files.paste",
          "when": "view == claudeProjects.files && viewItem =~ /^files\\./ && claudeProjects.files.canPaste",
          "group": "5_cutcopypaste@3"
        }
      ],
      "editor/title": [
        {
          "command": "claudeProjects.openSessionInClaudeExtension",
          "when": "activeWebviewPanelId == claudeProjects.chat",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Claude Projects",
      "properties": {
        "claudeProjects.claudePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `claude` CLI. Leave empty to find it automatically (`~/.local/bin/claude`, your shell `PATH`, Homebrew, npm's `claude.cmd` on Windows, or the binary bundled with the official Claude Code extension)."
        },
        "claudeProjects.sessions.defaultOpenMode": {
          "type": "string",
          "enum": [
            "here",
            "claudeExtension"
          ],
          "enumDescriptions": [
            "Open the session in this window, in the Claude Projects chat panel.",
            "Open the project in a new window and resume the session in the official Claude Code extension."
          ],
          "default": "here",
          "description": "What clicking a session does."
        },
        "claudeProjects.sessions.maxPerProject": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "description": "How many recent sessions to list under each project and worktree before \"Show more\"."
        },
        "claudeProjects.sessions.idleProcessTimeoutMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "markdownDescription": "Stop a session's Claude process after it has been idle this many minutes with its panel closed. It resumes automatically on your next message. `0` keeps processes until you close VS Code."
        },
        "claudeProjects.chat.defaultPermissionMode": {
          "type": "string",
          "enum": [
            "default",
            "acceptEdits",
            "plan",
            "auto",
            "yolo"
          ],
          "enumDescriptions": [
            "Manual: Claude asks before each edit and command.",
            "Edit automatically: file edits are accepted, commands still ask.",
            "Plan: Claude explores and presents a plan before editing.",
            "Auto: a safety check approves actions and pauses for anything risky.",
            "Yolo auto: auto mode, and every permission prompt is answered yes for you."
          ],
          "default": "default",
          "description": "Permission mode for new sessions opened here."
        },
        "claudeProjects.chat.defaultModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model for sessions opened here: an alias (`opus`, `sonnet`, `fable`, `haiku`) or a full model id such as `claude-opus-5-5`. Leave empty to use your Claude Code default."
        },
        "claudeProjects.chat.defaultEffort": {
          "type": "string",
          "enum": [
            "",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "enumDescriptions": [
            "The model default (or your Claude Code /effort setting).",
            "Low",
            "Medium",
            "High",
            "Extra high",
            "Max (session only, highest)"
          ],
          "default": "",
          "description": "Reasoning effort for new sessions opened here. You can change it per session from the effort picker in the chat."
        },
        "claudeProjects.chat.promptPresets": {
          "type": "array",
          "markdownDescription": "Prompts you can insert from the presets button in the chat composer. The preset goes in front of what you have typed; write your task after it.",
          "items": {
            "type": "object",
            "required": [
              "label",
              "prompt"
            ],
            "properties": {
              "label": {
                "type": "string",
                "description": "Name shown in the menu."
              },
              "prompt": {
                "type": "string",
                "description": "Text inserted into the message box."
              }
            }
          },
          "default": [
            {
              "label": "Worktree",
              "prompt": "Create a new worktree Commit as you go. Dont push. \n\n"
            },
            {
              "label": "PR",
              "prompt": "Open a PR and cleanup \n\n"
            },
            {
              "label": "Branch",
              "prompt": "Create a new branch and work on it. Commit as you go. Dont push. \n\n"
            }
          ]
        },
        "claudeProjects.chat.autoContinueAfterLimit": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Start new **Open Here** chats with *Continue automatically when limits reset* turned on. When a chat stops at a usage limit, it sends `continue` about a minute after the limit resets. You can switch it per chat with the button under the message box."
        },
        "claudeProjects.chat.globalEnvFile": {
          "type": "string",
          "default": "~/.claude-projects/.env",
          "markdownDescription": "A shared `.env` file for **Open Here** chats. Its variables are put in every chat's environment, so Claude can use them in commands (`$MY_API_KEY`) without the values appearing in the chat. Claude is told only the names. Edit it with **Claude Projects: Open Shared .env for Chats**."
        },
        "claudeProjects.chat.allowBypassPermissions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Offer the **Bypass permissions** mode in the chat mode picker. Claude then runs every command without asking."
        },
        "claudeProjects.chat.showYoloAutoMode": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer the **Yolo auto** mode in the chat mode picker. It is auto mode, and when Claude still asks for permission, the extension answers yes for you. Questions from Claude and plan reviews still wait for you. Turn this off to hide the mode (a chat already in Yolo auto keeps it until you switch)."
        },
        "claudeProjects.chat.iconOnlyTabs": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show **Open here** chat tabs as just their icon, without the session name, to fit more tabs. A dot still marks a session that is waiting for you or has news. The name stays everywhere else (Projects view, dashboard, the chat's own header)."
        },
        "claudeProjects.chat.showThinking": {
          "type": "boolean",
          "default": true,
          "description": "Ask Claude Code for thinking summaries and show them (collapsed) in the chat."
        },
        "claudeProjects.followActiveSession": {
          "type": "boolean",
          "default": true,
          "description": "When you switch to a session's chat tab, show that session's project in the Source Control and Files views."
        },
        "claudeProjects.terminal.location": {
          "type": "string",
          "enum": [
            "editor",
            "panel"
          ],
          "enumDescriptions": [
            "Open as a tab in the editor area, next to your Claude sessions.",
            "Open in the bottom terminal panel."
          ],
          "default": "editor",
          "description": "Where terminals opened from Claude Projects (Files and Projects views) appear."
        },
        "claudeProjects.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a system notification (macOS or Windows) when a session needs you."
        },
        "claudeProjects.notifications.onlyWhenUnfocused": {
          "type": "boolean",
          "default": true,
          "description": "Only send system notifications while VS Code is in the background. Inside VS Code you get the badge and a small toast."
        },
        "claudeProjects.notifications.onTurnComplete": {
          "type": "boolean",
          "default": true,
          "description": "Also notify when Claude finishes a turn and is waiting for your next message."
        },
        "claudeProjects.notifications.externalSessions": {
          "type": "boolean",
          "default": true,
          "description": "Also notify for sessions running outside this window (terminal, other VS Code windows, Claude desktop app) in your projects."
        },
        "claudeProjects.notifications.sound": {
          "type": "boolean",
          "default": true,
          "description": "Play a sound with system notifications."
        },
        "claudeProjects.notifications.inAppToasts": {
          "type": "boolean",
          "default": true,
          "description": "While VS Code is focused, show a toast when a session whose tab you are not looking at needs a permission, an answer or a plan review."
        },
        "claudeProjects.dashboard.showAllProjects": {
          "type": "boolean",
          "default": true,
          "description": "Show running Claude sessions from folders that are not in your project list too."
        },
        "claudeProjects.usage.refreshIntervalMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "How often to refresh your plan usage limits."
        },
        "claudeProjects.usage.showInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show 5-hour and weekly usage in the status bar."
        },
        "claudeProjects.files.confirmDragAndDrop": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Ask before moving files and folders by drag and drop in the **Files** view."
        }
      }
    },
    "keybindings": [
      {
        "command": "claudeProjects.files.rename",
        "key": "f2",
        "mac": "enter",
        "when": "focusedView == claudeProjects.files && !inputFocus"
      },
      {
        "command": "claudeProjects.files.delete",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == claudeProjects.files && !inputFocus"
      },
      {
        "command": "claudeProjects.files.cut",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "focusedView == claudeProjects.files && !inputFocus"
      },
      {
        "command": "claudeProjects.files.copy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == claudeProjects.files && !inputFocus"
      },
      {
        "command": "claudeProjects.files.paste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "focusedView == claudeProjects.files && !inputFocus"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "package": "node scripts/build.mjs --production && vsce package --no-dependencies --allow-missing-repository -o dist-vsix/claude-projects.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@types/vscode": "1.95.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1",
    "picomatch": "^4.0.7",
    "preact": "^11.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
